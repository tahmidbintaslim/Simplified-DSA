{
    "framework": "vite",
    "buildCommand": "pnpm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/mcp.js": {
            "includeFiles": "src/content/**"
        }
    },
    "rewrites": [
        {
            "source": "/mcp",
            "destination": "/api/mcp"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
